# Copy to .env and adjust. Every key maps to a config struct field by replacing
# "." with "_" (config.database.host -> DATABASE_HOST). Real environment
# variables always win over values in this file.

# ---------- Application ----------
APP_NAME=wms-saas
# development | staging | production
APP_ENV=development
APP_VERSION=0.1.0
APP_TIMEZONE=UTC

# ---------- HTTP server ----------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
# Grace period for in-flight requests during shutdown.
HTTP_SHUTDOWN_TIMEOUT=20s
# Comma-separated. "*" is rejected when APP_ENV=production.
HTTP_ALLOWED_ORIGINS=*

# ---------- PostgreSQL ----------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=wms
# No built-in default: this must be set explicitly, and must be non-empty when
# APP_ENV=production.
DATABASE_PASSWORD=wms
DATABASE_NAME=wms
# disable | require | verify-ca | verify-full. Must not be "disable" in production.
DATABASE_SSL_MODE=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_CONN_MAX_IDLE_TIME=10m
# silent | error | warn | info
DATABASE_LOG_LEVEL=warn
DATABASE_SLOW_THRESHOLD=200ms

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ---------- Logging ----------
# debug | info | warn | error
LOG_LEVEL=debug
# console (development) | json (production)
LOG_FORMAT=console

# ---------- Authentication ----------
# NO DEFAULT. Generate one per environment:  openssl rand -base64 48
# Must be >= 32 characters. Well-known placeholders are rejected at boot.
AUTH_JWT_SECRET=dev-only-secret-please-replace-me-with-openssl-rand
AUTH_JWT_ISSUER=wms-saas
AUTH_JWT_AUDIENCE=wms-saas-api
# Access tokens cannot be revoked, so this is the exposure window of a stolen
# one. Capped at 1h when APP_ENV=production.
AUTH_JWT_ACCESS_TOKEN_TTL=15m
AUTH_JWT_REFRESH_TOKEN_TTL=168h
AUTH_JWT_CLOCK_SKEW=30s
# Concurrent live sessions per user; the oldest is evicted at the cap. 0 = unlimited.
AUTH_JWT_MAX_SESSIONS_PER_USER=10
# bcrypt work factor. Minimum 12 in production; each increment doubles the cost.
AUTH_PASSWORD_BCRYPT_COST=12
